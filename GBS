			return inst:GetChildren();
		end);
	local pieces, bar = 0, nil;
	for _, pc in ipairs(okc and parts or {}) do
		local okn, nm = pcall(function()
				return pc.Name;
			end);
		if okn and nm == "Ore" then
			pieces = pieces + 1;
		elseif okn and nm == "Healthbar" then
			bar = pc;
		end;
	end;
	if okc and pieces == 0 then
		return nil;
	end;
