function mt.octant(ux, uz)
	local ok, lv = pcall(function()
			return workspace.CurrentCamera.CFrame.LookVector;
		end);
	local fx, fz = 0, -1;
	if ok and lv then
		local n = math.sqrt(lv.X * lv.X + lv.Z * lv.Z);
		if n > .001 then
			fx, fz = lv.X / n, lv.Z / n;
		end;
	end;
	local ang = math.atan2(ux * -fz + uz * fx, fx * ux + fz * uz);
	local q = math.floor(ang / (math.pi / 4) + .5) * (math.pi / 4);
